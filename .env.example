# Docker Compose interpolation. Native Python does not auto-load this file.
APP_ENV=development
DATABASE_PATH=/app/state/flareledger.sqlite3
DATA_DIR=/app/data

# Opt-in Gemini adapter: see docs/AI_SETUP.md. Keep disabled through review.
LLM_ENABLED=false
LLM_PROVIDER=gemini
# Explicit alternative: gemini-3.6-flash. No automatic model fallback.
LLM_MODEL=gemini-4-hydrogen
LLM_BASE_URL=
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=30
ASK_MAX_REQUESTS_PER_DAY=0
ASK_MAX_REQUESTS_PER_MINUTE=0
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_MAX_OUTPUT_TOKENS=2048

# Public frontend configuration only. VITE_* values are visible to the browser.
VITE_API_BASE_URL=/api
