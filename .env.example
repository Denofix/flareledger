# Proposed container configuration. Application loading is not implemented yet.
APP_ENV=development
DATABASE_PATH=/app/state/flareledger.sqlite3
DATA_DIR=/app/data

# Live generation stays disabled until an official API and its quota are verified.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
GEMINI_API_KEY=
FREELLMAPI_API_KEY=
LLM_TIMEOUT_SECONDS=30
ASK_MAX_REQUESTS_PER_DAY=0
ASK_MAX_REQUESTS_PER_MINUTE=0
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_MAX_OUTPUT_TOKENS=800

# Public frontend configuration only. VITE_* values are visible to the browser.
VITE_API_BASE_URL=/api
