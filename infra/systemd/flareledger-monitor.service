[Unit]
Description=Check FlareLedger readiness, TLS and backup age
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=tymofii
WorkingDirectory=/home/tymofii/flareledger-ops
UMask=0077
TimeoutStartSec=10min
# Exit status 1 marks the unit failed after every attempt failed; see systemctl --failed
# and journalctl -u flareledger-monitor.service.
ExecStart=/usr/bin/python3 /home/tymofii/flareledger-ops/scripts/monitor_production.py --mode local --snapshots /var/backups/flareledger/snapshots --attempts 3 --interval 60
